#!/bin/bash

# See ../doc/bin.md for description

function show_help() {
  cat << 'EOF'
free-macos - Show system-wide memory usage on macOS, like Linux' `free`

Usage:
  free-macos [--detail]
  free-macos -h | --help

Options:
  --detail    Show a total / used / available breakdown
  -h, --help  Show this help message

Description:
  Without options, prints the `PhysMem` line of `top -l 1 -s 0`, which is
  macOS' own summary of physical memory usage.

  With --detail, prints total / used / available computed from `vm_stat`
  page counters:

    used      = active + wired + compressor
    available = free + inactive + speculative
    total     = used + available

  Compressed pages are counted as used, so the numbers line up with what
  Activity Monitor reports rather than with a naive free-page count.

  Values are always scaled to a readable unit, like `free -h` does on
  Linux: 1024MiB and up in GiB with one decimal, smaller ones in MiB or
  KiB with no decimal.

  `total` is the memory macOS is currently accounting for, not the amount
  of RAM installed. It can fall a little short of the hardware total,
  since pages the counters do not cover are left out. Use
  `sysctl -n hw.memsize` when the installed size is what you need.

Note:
  Both modes take about a second, because `top -l 1` and `vm_stat` each
  sample the system once.

Dependencies:
  top, vm_stat (both macOS built-ins)

Examples:
  free-macos
  free-macos --detail
EOF
}

detail=false

for arg in "$@" ; do
  case "$arg" in
    -h | --help)
      show_help
      exit 0
      ;;
    --detail)
      detail=true
      ;;
    -*)
      echo "Error: Unknown option: $arg" >&2
      show_help >&2
      exit 1
      ;;
    *)
      echo "Error: Unexpected argument: $arg" >&2
      show_help >&2
      exit 1
      ;;
  esac
done

if [[ $DEBUG_BASHTOYS_PARSE_ONLY == '1' ]] ; then
  echo "detail=$detail"
  exit 0
fi

if [[ $(uname -s) != 'Darwin' ]] ; then
  echo 'Error: free-macos is supported on macOS only' >&2
  exit 1
fi

if [[ $detail == true ]] ; then
  if ! command -v vm_stat > /dev/null 2>&1 ; then
    echo 'Error: vm_stat is not available' >&2
    exit 1
  fi

  # Page counters are multiplied by the page size reported in vm_stat's header,
  # because it differs between architectures (4096 on Intel, 16384 on Apple
  # Silicon).
  vm_stat | awk '
    # Scales a MiB value the way `free -h` does: one decimal once the value
    # reaches GiB, no decimal below that.
    function readable(mb) {
      if (mb >= 1024) return sprintf("%.1fGiB", mb / 1024)
      if (mb >= 1) return sprintf("%.0fMiB", mb)
      return sprintf("%.0fKiB", mb * 1024)
    }

    /page size of/            { ps = $8 }
    /Pages free/              { free = $3+0 }
    /Pages active/            { active = $3+0 }
    /Pages inactive/          { inactive = $3+0 }
    /Pages wired/             { wired = $4+0 }
    /Pages occupied by comp/  { comp = $5+0 }
    /Pages speculative/       { spec = $3+0 }
    END {
      if (ps == 0) {
        print "Error: could not read the page size from vm_stat" > "/dev/stderr"
        exit 1
      }
      used_mb  = (active + wired + comp) * ps / 1024 / 1024
      avail_mb = (free + inactive + spec) * ps / 1024 / 1024
      total_mb = used_mb + avail_mb

      printf "total:     %9s\n", readable(total_mb)
      printf "used:      %9s\n", readable(used_mb)
      printf "available: %9s\n", readable(avail_mb)
    }
  '
  exit $?
fi

if ! command -v top > /dev/null 2>&1 ; then
  echo 'Error: top is not available' >&2
  exit 1
fi

# `-s 0` keeps top from sleeping between samples, so `-l 1` returns as soon as
# its single sample is taken.
physmem=$(top -l 1 -s 0 2> /dev/null | grep '^PhysMem')

if [[ $physmem == '' ]] ; then
  echo 'Error: could not read PhysMem from top' >&2
  exit 1
fi

echo "$physmem"

