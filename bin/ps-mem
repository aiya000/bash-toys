#!/bin/bash

# See ../doc/bin.md for description

function show_help() {
  cat << 'EOF'
ps-mem - Display per-process memory usage in a readable table (wraps ps and /proc, or the Windows host from WSL)

Usage:
  ps-mem [--swap] [--rss] [--uss] [--pss] [--footprint] [--pname] [--total]
         [--reverse] [--head [N] | --tail [N] | --all]
         [--process-name-max-length N] [--windows-from-wsl]
  ps-mem -h | --help

Options:
  --swap                          Include the SWAP column (Linux only)
  --rss                           Include the RSS column
  --uss                           Include the USS column (Linux and WSL only)
  --pss                           Include the PSS column (Linux only)
  --footprint                     Include the FOOTPRINT column (macOS only)
  --pname, --process-name         Place the COMMAND column at this position
  --total                         Append a TOTAL row summing the memory columns
  --reverse                       Sort descending, putting the biggest process
                                  at the top instead of the bottom
  --head [N]                      Show the first N rows only (default: 30)
  --tail [N]                      Show the last N rows only (default: 30)
  --all                           Show every row, cancelling --head and --tail
  --windows-from-wsl              List the processes of the Windows host
                                  instead of this Linux one (WSL only)
  -c, --process-name-max-length N Max width of the COMMAND column (default: 30)
  -h, --help                      Show this help message

Description:
  Always shows PID, USER, and COMMAND. Memory columns are selected via
  --swap, --rss, --uss, --pss, --footprint. Multiple options can be given,
  and the columns are shown in the order the options were passed. If no
  memory option is given, RSS is shown by default.

  COMMAND is placed right after USER by default. Pass --pname (or its
  long form --process-name) to position it explicitly, so that COMMAND
  takes part in the same ordering as the memory columns. For example,
  `ps-mem --rss --pname` shows PID, USER, RSS, COMMAND.

  Command names longer than the COMMAND column width are truncated with
  '...'. Use --process-name-max-length to widen (or narrow) that column.

  A horizontal rule as wide as the table is drawn under the header, so
  the columns stay readable once the command names start running long.

  Values are converted to MiB. Rows are sorted ascending by the memory
  column of the last memory option given, so the biggest process sits at
  the bottom. For example, `ps-mem --rss --footprint` sorts by FOOTPRINT,
  while `ps-mem --footprint --rss` sorts by RSS. --pname does not take
  part in that choice, so `ps-mem --pname` still sorts by RSS. --reverse
  flips that order, putting the biggest process at the top.

  Every process is listed by default. --head keeps the first N rows and
  --tail keeps the last N, where N defaults to 30 when omitted. The last
  of them wins if both are given, so `ps-mem --head 5 --tail 3` keeps the
  last three rows. --all cancels both, whatever their position, so an
  alias carrying --tail can be widened again with `ps-mem --tail --all`.

  The rows are cut before --total is computed, so the TOTAL row sums the
  rows actually printed and its 'N processes' label counts them. Combine
  --tail with --reverse --head to read the same processes from the other
  end of the table.

  --windows-from-wsl looks past the Linux side of WSL and lists the
  processes of the Windows host instead, so the Chrome or Teams that is
  eating the RAM your distribution is short of shows up in the same table.
  Every other option keeps its meaning: the columns, the sort, --head /
  --tail and --total all work the same way. It exits with an error outside
  WSL, since there is no Windows host to ask.

  Backends:
    Linux: ps, plus /proc/PID/smaps_rollup (Linux 4.14 or later)
           (--footprint exits with an error because it is a macOS metric)
    macOS: ps, plus `top` when --footprint is requested
           (--swap, --uss, and --pss exit with an error because macOS has
           no equivalent of them)
    WSL, with --windows-from-wsl:
           powershell.exe, reading Win32_Process, plus
           Win32_PerfRawData_PerfProc_Process when --uss is requested
           (--swap, --pss, and --footprint exit with an error because
           Windows has no equivalent of them)

Reading the numbers:
  Summing per-process memory never reproduces the usage the OS reports,
  and the gap can easily be several GiB. That is expected, not a bug:

    - RSS counts shared pages (libraries, frameworks) once per process,
      so adding RSS across processes counts them many times over.
    - On macOS, RSS excludes pages moved into the memory compressor, so a
      mostly idle process can look far smaller than it really is.
    - Kernel (wired) memory belongs to no process at all, so no
      per-process sum can reach the system total.

  So pick the column that answers your actual question:

    --rss         Physical RAM the process holds right now. Best for
                  "who is resident at this moment", and comparable with
                  other Unix tools. Available everywhere; under
                  --windows-from-wsl it is the Windows working set.
    --footprint   macOS only. What Activity Monitor shows in its "Memory"
                  column (phys_footprint), compressed pages included.
                  Reach for this when --rss looks suspiciously small.
                  Costs roughly a second, since it shells out to `top`.
    --pss         Linux only. Shared pages split across the processes
                  mapping them, so its sum is the closest to meaningful.
    --uss         Linux, and Windows via --windows-from-wsl, where it is
                  the private working set. Memory reclaimed if the process
                  exited. Best for "how much do I gain by killing this".

  --total appends a horizontal rule and a TOTAL row summing each memory
  column. A total of 10000.0MiB or more is shown in GiB instead, since
  five digit MiB values are hard to read. Use it to weigh processes
  against each other, not as a number to reconcile with `vm_stat`,
  `free`, or Activity Monitor. Combining it with --pss (Linux) or
  --footprint (macOS) gives the least misleading total.

Examples:
  ps-mem
  ps-mem --swap --rss
  ps-mem --rss --swap
  ps-mem --uss --pss --rss --swap
  ps-mem --rss --pname
  ps-mem --pname --rss
  ps-mem --footprint --rss --total
  ps-mem --pss --total
  ps-mem --reverse
  ps-mem --tail
  ps-mem --reverse --head 20
  ps-mem --pss --tail 10 --total
  ps-mem --tail 5 --all
  ps-mem --process-name-max-length 60
  ps-mem -c 60
  ps-mem --windows-from-wsl
  ps-mem --windows-from-wsl --uss --rss --reverse --head 20 --total
EOF
}

columns=()

# Max width of the COMMAND column; longer names are truncated with '...'
cmd_max=30

show_total=false

reverse=false

# 'none', 'head', or 'tail'. $limit_n is meaningless while this is 'none'.
limit_mode=none
limit_n=30

# --all cancels --head and --tail regardless of their order, so it is resolved
# after the whole argument list has been read
show_all=false

# Reads the Windows host's processes through powershell.exe instead of this
# Linux one's. Only reachable from WSL, where that interop exists.
windows_from_wsl=false

# Consumes the optional N of --head / --tail. Sets $limit_shift to how many
# arguments were used, since bash functions cannot shift the caller's "$@".
function read_limit_count() {
  local option=$1
  local value=$2

  limit_shift=1
  limit_n=30

  # A non-numeric next argument is not ours: it is the next option, or an error
  # the main loop reports
  if ! [[ $value =~ ^[0-9]+$ ]] ; then
    return 0
  fi

  if [[ $value -lt 1 ]] ; then
    echo "Error: $option requires a number of 1 or greater, got: $value" >&2
    exit 1
  fi

  limit_n=$value
  limit_shift=2
}

while [[ $# -gt 0 ]] ; do
  case "$1" in
    --swap)
      columns+=('SWAP')
      shift
      ;;
    --rss)
      columns+=('RSS')
      shift
      ;;
    --uss)
      columns+=('USS')
      shift
      ;;
    --pss)
      columns+=('PSS')
      shift
      ;;
    --footprint)
      columns+=('FOOTPRINT')
      shift
      ;;
    --pname | --process-name)
      columns+=('COMMAND')
      shift
      ;;
    --total)
      show_total=true
      shift
      ;;
    --reverse)
      reverse=true
      shift
      ;;
    --head)
      limit_mode=head
      read_limit_count --head "$2"
      shift "$limit_shift"
      ;;
    --tail)
      limit_mode=tail
      read_limit_count --tail "$2"
      shift "$limit_shift"
      ;;
    --all)
      show_all=true
      shift
      ;;
    --windows-from-wsl)
      windows_from_wsl=true
      shift
      ;;
    -c | --process-name-max-length)
      if [[ $2 == '' ]] ; then
        echo 'Error: --process-name-max-length requires a number' >&2
        exit 1
      fi
      if ! [[ $2 =~ ^[0-9]+$ ]] ; then
        echo "Error: --process-name-max-length requires a number, got: $2" >&2
        exit 1
      fi
      if [[ $2 -lt 4 ]] ; then
        echo 'Error: --process-name-max-length must be 4 or greater' >&2
        exit 1
      fi
      cmd_max=$2
      shift 2
      ;;
    -h | --help)
      show_help
      exit 0
      ;;
    *)
      echo "Error: Unknown option: $1" >&2
      show_help >&2
      exit 1
      ;;
  esac
done

# RSS is the default memory column. --pname alone does not count as one, so
# `ps-mem --pname` still shows RSS.
has_memory_column=false
needs_footprint=false
needs_uss=false
for column in "${columns[@]}" ; do
  if [[ $column != 'COMMAND' ]] ; then
    has_memory_column=true
  fi
  if [[ $column == 'FOOTPRINT' ]] ; then
    needs_footprint=true
  fi
  if [[ $column == 'USS' ]] ; then
    needs_uss=true
  fi
done

if [[ $has_memory_column == false ]] ; then
  columns+=('RSS')
fi

# Rows are sorted by the memory column of the last memory option given, so that
# the column the user asked for most recently is the one reading ascending.
# COMMAND takes no part in this, since --pname only positions a column.
sort_column=RSS
for column in "${columns[@]}" ; do
  if [[ $column != 'COMMAND' ]] ; then
    sort_column=$column
  fi
done

# Field number of $sort_column within the normalized stream that both backends
# emit (see $render_awk for its layout)
case "$sort_column" in
  SWAP)      sort_field=3 ;;
  USS)       sort_field=4 ;;
  PSS)       sort_field=5 ;;
  RSS)       sort_field=6 ;;
  FOOTPRINT) sort_field=7 ;;
esac

columns_csv=$(IFS=,; echo "${columns[*]}")

if [[ $show_all == true ]] ; then
  limit_mode=none
fi

if [[ $DEBUG_BASHTOYS_PARSE_ONLY == '1' ]] ; then
  echo "columns=$columns_csv"
  echo "cmd_max=$cmd_max"
  echo "total=$show_total"
  echo "sort=$sort_column"
  echo "reverse=$reverse"
  echo "limit=$limit_mode"
  echo "limit_n=$limit_n"
  echo "all=$show_all"
  echo "windows_from_wsl=$windows_from_wsl"
  exit 0
fi

# Shared by both backends, so that --reverse flips the secondary keys too
sort_options=(-s -t "$(printf '\t')" -n)
if [[ $reverse == true ]] ; then
  sort_options+=(-r)
fi

# Cuts the sorted stream down to --head / --tail. `head` is spelled as awk
# because `head` closes the pipe early, which makes `sort` upstream report a
# broken pipe.
function apply_limit() {
  case "$limit_mode" in
    head)
      awk -v n="$limit_n" 'NR <= n'
      ;;
    tail)
      tail -n "$limit_n"
      ;;
    *)
      cat
      ;;
  esac
}

if [[ $show_total == true ]] ; then
  total_flag=1
else
  total_flag=0
fi

# Renders the normalized stream produced by each backend.
#
# The normalized stream is tab separated, one process per line:
#   PID \t USER \t SWAP \t USS \t PSS \t RSS \t FOOTPRINT \t COMMAND
# Memory values are in KiB. Columns a backend cannot provide are 0, which is
# safe because such columns are rejected before reaching here.
#
# PID and USER are always printed first. COMMAND is printed right after USER
# unless it appears in $columns, in which case it is printed at that position.
render_awk='
# Renders a KiB value as MiB, or as GiB once it reaches 10000.0MiB. Five digit
# MiB values are hard to read at a glance, and only the TOTAL row realistically
# gets that large, so per-process rows stay in MiB.
function format_kib(kib,   mib) {
  mib = kib / 1024
  if (mib >= 10000) return sprintf("%.1fGiB", mib / 1024)
  return sprintf("%.1fMiB", mib)
}

BEGIN {
  n_cols = split(columns, col_list, ",")
  pid_w = 8
  user_w = 10
  cmd_w = 30
  has_cmd = 0
  for (i = 1; i <= n_cols; i++) {
    if (col_list[i] == "COMMAND") {
      has_cmd = 1
      col_w[i] = 30
    } else {
      col_w[i] = 12
    }
  }
}
{
  rows++
  r_pid[rows] = $1
  r_user[rows] = $2

  kib["SWAP"] = $3
  kib["USS"] = $4
  kib["PSS"] = $5
  kib["RSS"] = $6
  kib["FOOTPRINT"] = $7

  cmd = $8
  if (length(cmd) > cmd_max) cmd = substr(cmd, 1, cmd_max - 3) "..."

  if (length($1) > pid_w) pid_w = length($1)
  if (length($2) > user_w) user_w = length($2)

  if (!has_cmd) {
    r_cmd[rows] = cmd
    if (length(cmd) > cmd_w) cmd_w = length(cmd)
  }

  for (i = 1; i <= n_cols; i++) {
    name = col_list[i]
    if (name == "COMMAND") {
      value = cmd
    } else {
      sum[i] += kib[name]
      value = sprintf("%.1fMiB", kib[name] / 1024)
    }
    r_val[rows, i] = value
    if (length(value) > col_w[i]) col_w[i] = length(value)
  }
}
END {
  # Widths must be final before the header is printed, so build the TOTAL row
  # first even though it is printed last.
  if (total) {
    total_label = rows " processes"
    if (length(total_label) > cmd_max) total_label = substr(total_label, 1, cmd_max - 3) "..."
    if (length("TOTAL") > pid_w) pid_w = length("TOTAL")
    if (!has_cmd && length(total_label) > cmd_w) cmd_w = length(total_label)
    for (i = 1; i <= n_cols; i++) {
      if (col_list[i] == "COMMAND") t_val[i] = total_label
      else t_val[i] = format_kib(sum[i])
      if (length(t_val[i]) > col_w[i]) col_w[i] = length(t_val[i])
    }
  }

  header = sprintf("%-*s %-*s", pid_w, "PID", user_w, "USER")
  if (!has_cmd) header = header sprintf(" %-*s", cmd_w, "COMMAND")
  for (i = 1; i <= n_cols; i++) {
    if (col_list[i] == "COMMAND") header = header sprintf(" %-*s", col_w[i], "COMMAND")
    else header = header sprintf(" %*s", col_w[i], col_list[i])
  }
  print header

  # A horizontal rule under the header, as wide as the table, so the columns
  # stay readable once the command names start running long
  separator = sprintf("%*s", length(header), "")
  gsub(/ /, "-", separator)
  print separator

  for (j = 1; j <= rows; j++) {
    row = sprintf("%-*s %-*s", pid_w, r_pid[j], user_w, r_user[j])
    if (!has_cmd) row = row sprintf(" %-*s", cmd_w, r_cmd[j])
    for (i = 1; i <= n_cols; i++) {
      if (col_list[i] == "COMMAND") row = row sprintf(" %-*s", col_w[i], r_val[j, i])
      else row = row sprintf(" %*s", col_w[i], r_val[j, i])
    }
    print row
  }

  if (total) {
    print separator

    row = sprintf("%-*s %-*s", pid_w, "TOTAL", user_w, "-")
    if (!has_cmd) row = row sprintf(" %-*s", cmd_w, total_label)
    for (i = 1; i <= n_cols; i++) {
      if (col_list[i] == "COMMAND") row = row sprintf(" %-*s", col_w[i], t_val[i])
      else row = row sprintf(" %*s", col_w[i], t_val[i])
    }
    print row
  }
}
'

if [[ $windows_from_wsl == true ]] ; then
  # Windows counts committed memory rather than swapped-out pages, and shares
  # no page accounting between processes, so it has nothing to put in SWAP or
  # PSS. FOOTPRINT stays a macOS metric wherever it is asked for.
  for column in "${columns[@]}" ; do
    case "$column" in
      SWAP)
        echo 'Error: --swap is not supported with --windows-from-wsl' >&2
        exit 1
        ;;
      PSS)
        echo 'Error: --pss is not supported with --windows-from-wsl' >&2
        exit 1
        ;;
      FOOTPRINT)
        echo 'Error: --footprint is supported on macOS only' >&2
        exit 1
        ;;
    esac
  done

  if [[ $WSL_INTEROP == '' ]] ; then
    echo 'Error: --windows-from-wsl requires WSL (Windows interop is unavailable)' >&2
    exit 1
  fi

  if ! command -v powershell.exe > /dev/null ; then
    echo 'Error: --windows-from-wsl requires powershell.exe, which is not on PATH' >&2
    exit 1
  fi

  # The Windows side of the table is read through powershell.exe, which emits
  # the very stream $render_awk expects, so the sort, --head / --tail, --total
  # and the renderer below are shared with the two Unix backends.
  #
  # Win32_Process carries both WorkingSetSize, which is Windows' name for RSS,
  # and the full command line, so one query covers every column but USS.
  #
  # USER is in neither class. Asking Win32_Process for its owner directly costs
  # one WMI call per process, over a minute on an ordinary desktop, so the
  # logon sessions are joined to the processes instead: two more queries, but
  # they finish in a fraction of a second. Processes owned by no logon session
  # of their own (services, and the kernel side of Windows) are left as '-',
  # the way `ps` shows a user it cannot name.
  windows_prelude_ps1=$(cat << 'EOF'
$ErrorActionPreference = 'SilentlyContinue'
[Console]::OutputEncoding = [Text.Encoding]::UTF8
$owner_of_logon = @{}
foreach ($logon in Get-CimInstance Win32_LoggedOnUser) { $owner_of_logon[$logon.Dependent.LogonId] = $logon.Antecedent.Name }
$owner = @{}
foreach ($session in Get-CimInstance Win32_SessionProcess) { $name = $owner_of_logon[$session.Antecedent.LogonId]; if ($name) { $owner[[string]$session.Dependent.Handle] = $name } }
$uss = @{}
EOF
)

  # The private working set, which is what USS means on Windows, lives in the
  # performance counter class rather than in Win32_Process. Only queried when
  # --uss was actually requested: the first such query of a session has to warm
  # the counter cache up, which can cost several seconds.
  windows_uss_ps1=$(cat << 'EOF'
foreach ($counter in Get-CimInstance Win32_PerfRawData_PerfProc_Process) { $uss[[string]$counter.IDProcess] = $counter.WorkingSetPrivate }
EOF
)

  # PID 0 is the System Idle Process, which is not a process at all: it is how
  # Windows accounts for idle CPU, and its counters would only distort --total.
  #
  # Newlines and tabs are folded into spaces for the same reason the Linux
  # backend takes its command lines from `ps`: an argument containing one would
  # otherwise split a single process across several rows.
  windows_emit_ps1=$(cat << 'EOF'
foreach ($process in Get-CimInstance Win32_Process) {
  if ($process.ProcessId -eq 0) { continue }
  $id = [string]$process.ProcessId
  $user = $owner[$id]
  if (-not $user) { $user = '-' }
  $command = $process.CommandLine
  if (-not $command) { $command = $process.Name }
  $command = $command -replace '[\r\n\t]+', ' '
  $private = 0
  if ($uss.ContainsKey($id)) { $private = [long]($uss[$id] / 1024) }
  $resident = [long]($process.WorkingSetSize / 1024)
  [Console]::Out.WriteLine("$id`t$user`t0`t$private`t0`t$resident`t0`t$command")
}
EOF
)

  windows_ps1=$windows_prelude_ps1
  if [[ $needs_uss == true ]] ; then
    windows_ps1="$windows_ps1"$'\n'"$windows_uss_ps1"
  fi
  windows_ps1="$windows_ps1"$'\n'"$windows_emit_ps1"

  # powershell.exe ends its lines with CRLF, and a stray '\r' would ride along
  # to the end of COMMAND and back over the row once printed
  windows_rows=$(powershell.exe -NoProfile -NonInteractive -Command "$windows_ps1" | tr -d '\r')
  if [[ $windows_rows == '' ]] ; then
    echo 'Error: powershell.exe reported no Windows process' >&2
    exit 1
  fi

  # `-k 6,6` (RSS) is a secondary key so that RSS breaks ties within the sorted
  # column, as it does on Linux
  printf '%s\n' "$windows_rows" \
    | sort "${sort_options[@]}" -k "$sort_field,$sort_field" -k 6,6 \
    | apply_limit \
    | awk -F '\t' -v columns="$columns_csv" -v cmd_max="$cmd_max" -v total="$total_flag" "$render_awk"
  exit $?
fi

# Emits `top`'s per-process phys_footprint, which is the value Activity Monitor
# shows in its "Memory" column. Only run when FOOTPRINT was requested, since
# `top -l 1` costs about a second.
#
# The leading '#' is a sentinel: it guarantees this stream is never empty, so
# the NR == FNR trick below keeps working even when FOOTPRINT is not requested.
#
# `-n` is required because top otherwise limits its rows to the terminal
# height, which yields no process at all when stdout is a pipe.
function emit_footprint_table() {
  echo '#'
  if [[ $needs_footprint == true ]] ; then
    top -l 1 -n 100000 -stats pid,mem 2> /dev/null
  fi
}

if [[ $(uname -s) == 'Darwin' ]] ; then
  # macOS has no /proc, so smaps_rollup is unavailable. `ps` provides RSS only.
  for column in "${columns[@]}" ; do
    case "$column" in
      SWAP)
        echo 'Error: --swap is not supported on macOS' >&2
        exit 1
        ;;
      USS)
        echo 'Error: --uss is not supported on macOS' >&2
        exit 1
        ;;
      PSS)
        echo 'Error: --pss is not supported on macOS' >&2
        exit 1
        ;;
    esac
  done

  # `ps` is pre-sorted by RSS even though the normalized stream is sorted
  # afterwards, because that sort is stable: RSS then breaks ties within the
  # sorted column.
  awk -v OFS='\t' '
  NR == FNR {
    if ($1 ~ /^[0-9]+$/ && NF >= 2) {
      value = $2
      sub(/[^0-9.BKMGTbkmgt]+$/, "", value)
      unit = toupper(substr(value, length(value), 1))
      number = substr(value, 1, length(value) - 1) + 0
      if (unit == "B") footprint[$1] = number / 1024
      else if (unit == "K") footprint[$1] = number
      else if (unit == "M") footprint[$1] = number * 1024
      else if (unit == "G") footprint[$1] = number * 1024 * 1024
      else if (unit == "T") footprint[$1] = number * 1024 * 1024 * 1024
      else footprint[$1] = (value + 0) / 1024
    }
    next
  }
  {
    cmd = ""
    for (i = 4; i <= NF; i++) cmd = cmd (cmd == "" ? "" : " ") $i
    print $1, $2, 0, 0, 0, $3, (($1 in footprint) ? footprint[$1] : 0), cmd
  }' <(emit_footprint_table) <(ps -axo pid,user,rss,comm | tail -n +2 | sort -k3 -n) \
    | sort "${sort_options[@]}" -k "$sort_field,$sort_field" \
    | apply_limit \
    | awk -F '\t' -v columns="$columns_csv" -v cmd_max="$cmd_max" -v total="$total_flag" "$render_awk"
  exit $?
fi

for column in "${columns[@]}" ; do
  if [[ $column == 'FOOTPRINT' ]] ; then
    echo 'Error: --footprint is supported on macOS only' >&2
    exit 1
  fi
done

# /proc/PID/smaps_rollup (Linux 4.14+) carries the per-process sums of
# /proc/PID/smaps, which is exactly what smem computes, so no extra tool is
# needed. Its Rss, Pss, and Swap lines map to the columns of the same name,
# and USS is Private_Clean + Private_Dirty.
if [[ ! -r /proc/self/smaps_rollup ]] ; then
  echo 'Error: /proc/PID/smaps_rollup is not available (Linux 4.14 or later is required)' >&2
  exit 1
fi

# PID, USER, and COMMAND come from `ps` rather than /proc/PID/cmdline, because
# `ps` folds newlines and other control characters in the command line into
# spaces or '?'. A raw command line can contain newlines (an awk script passed
# as an argument, for instance), which would split one process across several
# lines of the normalized stream. `user:32` keeps long user names from being
# truncated with '+', and `-ww` keeps long command lines intact.
#
# Processes whose smaps_rollup cannot be read are skipped, like smem did: other
# users' processes when not running as root, kernel threads (whose rollup has
# no Rss line), and processes that exited between `ps` and here.
#
# `-k 6,6` (RSS) is a secondary key so that RSS breaks ties within the sorted
# column.
ps -eww -o pid=,user:32=,args= | awk -v OFS='\t' '
{
  file = "/proc/" $1 "/smaps_rollup"
  found = 0
  swap = uss = pss = rss = 0
  while ((getline line < file) > 0) {
    split(line, f)
    if (f[1] == "Rss:") {
      rss = f[2]
      found = 1
    } else if (f[1] == "Pss:") {
      pss = f[2]
    } else if (f[1] == "Swap:") {
      swap = f[2]
    } else if (f[1] == "Private_Clean:" || f[1] == "Private_Dirty:") {
      uss += f[2]
    }
  }
  close(file)
  if (!found) next

  cmd = ""
  for (i = 3; i <= NF; i++) cmd = cmd (cmd == "" ? "" : " ") $i
  print $1, $2, swap, uss, pss, rss, 0, cmd
}' \
  | sort "${sort_options[@]}" -k "$sort_field,$sort_field" -k 6,6 \
  | apply_limit \
  | awk -F '\t' -v columns="$columns_csv" -v cmd_max="$cmd_max" -v total="$total_flag" "$render_awk"

