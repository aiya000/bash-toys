#!/bin/bash

function show_help() {
  cat << 'EOF'
docker-fix - Docker maintenance utilities

Usage:
  docker-fix <subcommand>
  docker-fix -h | --help

Subcommands:
  teardown-compose  Run: docker compose down -v --remove-orphans
  clean-containers  Run: docker container prune -f
  clean-volumes     Run: docker volume prune -f
  remove-volumes    Run: docker volume rm $(docker volume ls -q)
  remove-all        Run all of the above subcommands in order

Options:
  -h, --help    Show this help message
EOF
}

function run-with-echo() {
  echo "$*"
  eval "$*"
  echo
}

function cmd-teardown-compose() {
  run-with-echo 'docker compose down -v --remove-orphans'
}

function cmd-clean-containers() {
  run-with-echo 'docker container prune -f'
}

function cmd-clean-volumes() {
  run-with-echo 'docker volume prune -f'
}

function cmd-remove-volumes() {
  run-with-echo "docker volume rm $(docker volume ls -q)"
}

function cmd-remove-all() {
  cmd-teardown-compose
  cmd-clean-containers
  cmd-clean-volumes
  cmd-remove-volumes
}

case "$1" in
  --help|-h)
    show_help
    exit 0
    ;;
  teardown-compose)  cmd-teardown-compose ;;
  clean-containers)  cmd-clean-containers ;;
  clean-volumes)     cmd-clean-volumes ;;
  remove-volumes)    cmd-remove-volumes ;;
  remove-all)        cmd-remove-all ;;
  -*)
    echo "Error: Unknown option: $1" >&2
    echo >&2
    show_help >&2
    exit 1
    ;;
  *)
    echo "Error: unknown subcommand '$1'" >&2
    echo >&2
    show_help >&2
    exit 1
    ;;
esac

