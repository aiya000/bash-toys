#!/bin/bash

# See ../doc/bin.md for description

function show_help() {
  cat << 'EOF'
is-in-macos - Check if running on macOS

Usage:
  is-in-macos
  is-in-macos -h | --help

Options:
  -h, --help    Show this help message

Description:
  Returns exit code 0 if running on macOS (Darwin), 1 otherwise.
  Useful for conditional logic in shell scripts.

Examples:
  is-in-macos && echo 'macOS' || echo 'Not macOS'
  if is-in-macos; then echo "Running on macOS"; fi
EOF
}

[[ $1 == --help || $1 == -h ]] && show_help && exit 0

[[ $(uname) == 'Darwin' ]]

