#!/bin/bash

function show_help() {
  cat << 'EOF'
docker-tool - Docker utilities

Usage:
  docker-tool [run] <subcommand> [<subcommand>...]
  docker-tool -h | --help

Subcommands:
  attach-menu       Interactively select and attach to a running container
  kill-menu         Interactively select and kill a running container
  teardown-compose  Run: docker compose down -v --remove-orphans
  clean-containers  Run: docker container prune -f
  clean-volumes     Run: docker volume prune -f
  clean-build-cache Run: docker builder prune -af
  clean-builder     Alias for clean-build-cache
  remove-volumes    Run: docker volume rm $(docker volume ls -q)

Options:
  -h, --help    Show this help message

Environment:
  BASH_TOYS_INTERACTIVE_FILTER    Filter command for attach-menu / kill-menu (e.g., fzf, peco)
EOF
}

function run-with-echo() {
  echo "$*"
  eval "$*"
  echo
}

function cmd-attach-menu() {
  local dir
  dir=$(dirname "$0")
  # shellcheck disable=SC1091
  source "$dir/../define-options.sh"
  docker attach "$(docker ps | "$BASH_TOYS_INTERACTIVE_FILTER" | awk '{print $1}')"
}

function cmd-kill-menu() {
  local dir
  dir=$(dirname "$0")
  # shellcheck disable=SC1091
  source "$dir/../define-options.sh"
  docker kill "$(docker ps | "$BASH_TOYS_INTERACTIVE_FILTER" | awk '{print $1}')"
}

function cmd-teardown-compose() {
  run-with-echo 'docker compose down -v --remove-orphans'
}

function cmd-clean-containers() {
  run-with-echo 'docker container prune -f'
}

function cmd-clean-volumes() {
  run-with-echo 'docker volume prune -f'
}

function cmd-clean-build-cache() {
  run-with-echo 'docker builder prune -af'
}

function cmd-remove-volumes() {
  run-with-echo "docker volume rm $(docker volume ls -q)"
}

function dispatch() {
  case "$1" in
    attach-menu)       cmd-attach-menu ;;
    kill-menu)         cmd-kill-menu ;;
    teardown-compose)  cmd-teardown-compose ;;
    clean-containers)  cmd-clean-containers ;;
    clean-volumes)     cmd-clean-volumes ;;
    clean-build-cache) cmd-clean-build-cache ;;
    clean-builder)     cmd-clean-build-cache ;;
    remove-volumes)    cmd-remove-volumes ;;
    *)
      echo "Error: unknown subcommand '$1'" >&2
      exit 1
      ;;
  esac
}

function cmd-run() {
  if [[ $# == 0 ]] ; then
    echo "Error: at least one subcommand is required" >&2
    echo >&2
    show_help >&2
    exit 1
  fi
  for subcmd in "$@" ; do
    dispatch "$subcmd"
  done
}

case "$1" in
  --help|-h)
    show_help
    exit 0
    ;;
  run)
    shift
    cmd-run "$@"
    ;;
  -*)
    echo "Error: Unknown option: $1" >&2
    echo >&2
    show_help >&2
    exit 1
    ;;
  '')
    echo "Error: at least one subcommand is required" >&2
    echo >&2
    show_help >&2
    exit 1
    ;;
  *)
    cmd-run "$@"
    ;;
esac

