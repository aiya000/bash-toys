#!/bin/bash

# See ../doc/bin.md for description

function show_help() {
  cat << 'EOF'
is-in-windows-path - Check if the current directory is on a Windows-mounted path (WSL)

Usage:
  is-in-windows-path
  is-in-windows-path -h | --help

Options:
  -h, --help    Show this help message

Description:
  Returns exit code 0 if the current directory is bridged in from Windows
  (under /mnt/*, ~/Windows, or ~/Desktop), 1 otherwise.

  Useful for deciding when to bridge to native Windows tools (e.g.
  git-bridge-wsl-and-windows) instead of their WSL-native equivalents,
  since WSL-native tools can be slow or unsupported on Windows filesystems.

Examples:
  is-in-windows-path && echo 'Windows path' || echo 'Not a Windows path'
  if is-in-windows-path; then echo "On a Windows-mounted path"; fi
EOF
}

[[ $1 == --help || $1 == -h ]] && show_help && exit 0

pwd=$(pwd -P)

[[ $pwd =~ ^/mnt ]] || [[ $pwd =~ ^/home/$USER/Windows ]] || [[ $pwd =~ ^/home/$USER/Desktop ]]

