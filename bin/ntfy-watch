#!/bin/bash

# See ../doc/bin.md for description

FILTERED_EVENTS=('keepalive')
ATTACHMENTS_SIZE_LIMIT=100M

container_id=
ntfy_serve_pid=
curl_pid=

function show_help() {
  cat << EOF
Usage: ntfy-watch [--docker] [--protocol PROTOCOL] [--host HOST] [--port PORT] [--topic TOPIC]
       ntfy-watch (-h | --help)

Start a self-hosted ntfy server and subscribe to its event stream.
Without --docker, runs the local \`ntfy\` binary directly on this machine.
With --docker, runs it in Docker instead.
Automatically stops the server on exit (including Ctrl+C).

Options:
  --docker               Run the ntfy server in Docker instead of the local \`ntfy\` binary
  --protocol PROTOCOL    Protocol to use (default: http, or parsed from BASH_TOYS_NTFY_SERVING_URL)
  --host HOST            Hostname or IP address (default: localhost, or parsed from BASH_TOYS_NTFY_SERVING_URL)
  --port PORT            Port number (default: 80, or parsed from BASH_TOYS_NTFY_SERVING_URL)
  --topic TOPIC          Topic name to subscribe (default: default)

Environment Variables:
  BASH_TOYS_NTFY_SERVING_URL    Full base URL like http://192.168.1.10:18432
  BASH_TOYS_TMP_BASE_DIR        Base directory for attachment cache

Examples:
  ntfy-watch
  ntfy-watch --docker
  ntfy-watch --host 192.168.1.10 --port 18432
  ntfy-watch --docker --protocol https --host 192.168.1.10 --port 18432
  BASH_TOYS_NTFY_SERVING_URL=http://192.168.1.10:18432 ntfy-watch

EOF
}

opt_docker=false
opt_protocol=
opt_host=
opt_port=
opt_topic=

while [[ $# -gt 0 ]] ; do
  case "$1" in
    --docker)
      opt_docker=true
      shift
      ;;
    --protocol)
      opt_protocol="$2"
      shift 2
      ;;
    --host)
      opt_host="$2"
      shift 2
      ;;
    --port)
      opt_port="$2"
      shift 2
      ;;
    --topic)
      opt_topic="$2"
      shift 2
      ;;
    -h | --help)
      show_help
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      show_help >&2
      exit 1
      ;;
  esac
done

function parse_protocol() {
  if [[ $opt_protocol != '' ]] ; then
    echo "$opt_protocol"
    return
  fi
  if [[ $BASH_TOYS_NTFY_SERVING_URL != '' ]] ; then
    local parsed="${BASH_TOYS_NTFY_SERVING_URL%%://*}"
    if [[ $parsed != '' && $parsed != $BASH_TOYS_NTFY_SERVING_URL ]] ; then
      echo "$parsed"
      return
    fi
  fi
  echo 'Could not determine protocol. Falling back to http.' >&2
  echo 'http'
}
protocol=$(parse_protocol)

function parse_host() {
  if [[ $opt_host != '' ]] ; then
    echo "$opt_host"
    return
  fi
  if [[ $BASH_TOYS_NTFY_SERVING_URL != '' ]] ; then
    local temp="${BASH_TOYS_NTFY_SERVING_URL#*://}"
    local parsed="${temp%%:*}"
    if [[ $parsed != '' ]] ; then
      echo "$parsed"
      return
    fi
  fi
  echo 'Could not determine host. Falling back to localhost.' >&2
  echo 'localhost'
}
host=$(parse_host)

function parse_port() {
  if [[ $opt_port != '' ]] ; then
    echo "$opt_port"
    return
  fi
  if [[ $BASH_TOYS_NTFY_SERVING_URL != '' ]] ; then
    local parsed="${BASH_TOYS_NTFY_SERVING_URL##*:}"
    if [[ $parsed =~ ^[0-9]+$ ]] ; then
      echo "$parsed"
      return
    fi
  fi
  echo 'Could not determine port. Falling back to 80.' >&2
  echo '80'
}
port=$(parse_port)

topic="${opt_topic:-default}"

base_url="$protocol://$host:$port"
authority="$host:$port"

if [[ $DEBUG_BASHTOYS_PARSE_ONLY == '1' ]] ; then
  echo "docker=$opt_docker"
  echo "protocol=$protocol"
  echo "host=$host"
  echo "port=$port"
  echo "topic=$topic"
  echo "base_url=$base_url"
  exit 0
fi

if ! command -v jq > /dev/null 2>&1 ; then
  echo 'Error: jq command not found. Install it (https://jqlang.org).' >&2
  exit 1
fi

function find_attachement_dir() {
  if [[ $BASH_TOYS_TMP_BASE_DIR != '' ]] ; then
    echo "$BASH_TOYS_TMP_BASE_DIR/ntfy-watch"
    return
  fi

  echo "Coudn't find a directory for attachment files. Fallback to /tmp" >&2
}

function format_event() {
  jq -r '
    def human_time: localtime | strftime("%Y-%m-%d %H:%M");
    ("\n>>> " + (.time | human_time)) as $header
    | (if has("expires") then .expires |= human_time else . end) as $obj
    | $header + "\n" + ($obj | del(.time) | to_entries | map("- \(.key): \(.value)") | join("\n"))
  '
}

function filter_events() {
  while IFS= read -r line ; do
    for event in "${FILTERED_EVENTS[@]}" ; do
      [[ "$line" == *"\"event\":\"$event\""* ]] && continue 2
    done
    echo "$line" | format_event
  done
}

function cleanup() {
  if [[ $curl_pid != '' ]] ; then
    kill "$curl_pid" 2>/dev/null
  fi
  if [[ $opt_docker == true ]] ; then
    if [[ $container_id != '' ]] ; then
      docker stop "$container_id" 2>/dev/null
    fi
  else
    if [[ $ntfy_serve_pid != '' ]] ; then
      kill "$ntfy_serve_pid" 2>/dev/null
    fi
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

attachments_store_dir=$(find_attachement_dir)

if [[ ! -d $attachments_store_dir ]] ; then
  mkdir -p "$attachments_store_dir"
fi

if [[ $opt_docker == true ]] ; then
  container_id=$( \
    docker run -d \
    -p "$port:80" \
    -v $attachments_store_dir:/attachments \
    binwiederhier/ntfy serve \
    --attachment-cache-dir /attachments \
    --attachment-file-size-limit "$ATTACHMENTS_SIZE_LIMIT" \
    --attachment-total-size-limit "$ATTACHMENTS_SIZE_LIMIT" \
    --base-url "$base_url" \
  )

  if [[ $container_id == '' ]] ; then
    echo "Error: Failed to start the ntfy Docker container. Is Docker running?" >&2
    exit 1
  fi

  echo "ntfy container: $container_id"
else
  if ! command -v ntfy > /dev/null 2>&1 ; then
    echo "Error: ntfy command not found. Install it (https://ntfy.sh), or use --docker instead." >&2
    exit 1
  fi

  ntfy serve \
    --listen-http ":$port" \
    --attachment-cache-dir "$attachments_store_dir" \
    --attachment-file-size-limit "$ATTACHMENTS_SIZE_LIMIT" \
    --attachment-total-size-limit "$ATTACHMENTS_SIZE_LIMIT" \
    --base-url "$base_url" \
    &
  ntfy_serve_pid=$!

  echo "ntfy process: $ntfy_serve_pid"
fi

echo "Base URL: $base_url"
echo "Topic: $topic"

# Wait for server ready
until curl -sf "$base_url/v1/health" > /dev/null 2>&1 ; do
  sleep 0.3
done

curl -sN "$authority/$topic/json" | filter_events &
curl_pid=$!

wait "$curl_pid"

